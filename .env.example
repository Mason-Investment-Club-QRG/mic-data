# Centralized local secrets for mic-data.
# Copy this file to `.env` and fill values.

# Google service-account JSON path (relative to repo root or absolute path)
GOOGLE_APPLICATION_CREDENTIALS=secrets/service_account.json

# WRDS credentials (password optional if .pgpass is configured)
WRDS_USERNAME=your_wrds_username
WRDS_PASSWORD=

# Optional macro-data key used by src/mic_data/sources.py
FRED_API_KEY=
